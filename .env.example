ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db
DATABASE_USER=admin
DATABASE_PASSWORD=password

# Íconos de servidor (S3). Sin S3_BUCKET, crear un servidor con ícono responde 503.
# Credenciales en local: AWS_PROFILE o AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (las lee boto3).
AWS_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
