ENVIRONMENT=development
HOST=0.0.0.0
PORT=8080

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db
DATABASE_USER=admin
DATABASE_PASSWORD=password

# Íconos de servidor (S3).
# Claves del usuario IAM del servicio (o uno de desarrollo). Sin claves o sin bucket, la subida responde 503.
AWS_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
